# ==========================================
# Xiaozhi AI MCP Center Environment Configuration
# ==========================================

# GEMINI_API_KEY: Optional key for Gemini AI API calls and conversational tool reasoning.
# If omitted or left as default, the center operates in local deterministic intent mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public or local URL where this server is reachable.
# Used for generating configuration snippets for Xiaozhi ESP32-S3 and Claude Desktop.
APP_URL="http://localhost:3000"

# PORT: Port to bind the HTTP server to (defaults to 3000)
PORT=3000

# NODE_ENV: Runtime environment (development or production)
NODE_ENV=development

# XIAOZHI_MCP_WS_URL: Official Xiaozhi Cloud Gateway entry point (optional)
# Paste your tokenized WebSocket URL from the Xiaozhi platform dashboard to connect automatically on boot:
XIAOZHI_MCP_WS_URL="wss://api.xiaozhi.me/mcp/?token=YOUR_TOKEN_HERE"
